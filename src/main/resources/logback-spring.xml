<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appVersion" source="app.version" defaultValue="local"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level service=cinema-api version=${appVersion} requestId=%X{requestId:-none} logger=%logger{36} - %msg%n%ex{full}</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
